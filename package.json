{
  "name": "@philomelcc/dsh-idea-wall",
  "version": "0.1.2",
  "type": "module",
  "description": "灵感墙：左栏一面便签墙，会话里说一句「我有一个灵感」自动总结挂墙。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "idea",
    "notes",
    "wall",
    "workbench"
  ],
  "author": "Philomel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philomelcc/dsh-idea-wall.git"
  },
  "homepage": "https://github.com/philomelcc/dsh-idea-wall#readme",
  "bugs": {
    "url": "https://github.com/philomelcc/dsh-idea-wall/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
