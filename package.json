{
  "name": "@local/dsh-idea-wall",
  "version": "0.1.0",
  "type": "module",
  "description": "灵感墙：左栏一面便签墙，会话里说一句「我有一个灵感」自动总结挂墙。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "idea",
    "notes",
    "wall"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "private": true
}
